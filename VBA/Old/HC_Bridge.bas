Attribute VB_Name = "HC_Bridge"
Option Explicit

' ---------------------------------------------------------------------------------------------------------------------
' モジュール名: HC_Bridge (標準モジュール)
' 作成日: 2026-01-29
' 改版番号および履歴:
'   1.5.1 (2026-02-02) [保守強化] VBA開発規定に基づくヘッダおよび内部コメントの厳格化、命名短縮化。
'   1.5.0 (2026-02-02) [仕様変更] ステータス情報と通知情報の物理分離に伴う改修。
'                          ステータスバー復旧時に HC_STATUS_INFO を優先参照するよう同期。
'   1.4.0 (2026-01-31) [基盤刷新] Base64 GUID + シートプロパティ管理方式への換装。
' プロシージャの動作概要: Excel ステータスバーの表示状態を物理管理する。
'                          シート切り替えイベントに同期し、各シート固有の最新実行情報をプロパティから吸引・表示する。
' 注意事項: 物理的な CodeName やブックレベルのプロパティは一切参照しない。
'           情報の正本は各 Worksheet の CustomProperties (HC_STATUS_INFO) に集約されている。
'           マルチステートメント（:）の使用、および Comm クラスの直接参照は厳禁とする。
' ---------------------------------------------------------------------------------------------------------------------

' ==============================================================================
' ステータスバー表示制御セクション
' ==============================================================================

' ---------------------------------------------------------------------------------------------------------------------
' プロシージャ名: RestoreStatBar
' 作成日: 2026-01-29
' 改版番号および履歴:
'   1.3.1 (2026-02-02) スタイル規定に基づくリファクタリング（変数名短縮、ログ強化）。
'   1.3.0 (2026-02-02) ステータス専用キー (HC_STATUS_INFO) からの吸引へロジックを変更。
' プロシージャの動作概要: アクティブシートの GUID に基づき、シート内部に保存された最新の実行状態情報を吸引し、
'                          Excel のステータスバーを物理復元する。
' 引数: なし
' 戻り値: なし
' 呼出し例: Call HC_Bridge.RestoreStatBar()
' ヘルパープロシージャの親子関係:
'   (親) AppEventClass.App_SheetActivate, Main.RunPythonSafe
'   (子) ExcelUtil.GetSheetIdSafe, ExcelUtil.GetSheetInfo, HC_Log.Info, HC_Log.Error
' 注意事項: アクティブシートが存在しない場合は即座に終了する。GUID 未刻印シートは解析対象外として扱う。
' ---------------------------------------------------------------------------------------------------------------------
Public Sub RestoreStatBar()
    Dim sId As String                                       ' シート識別用 GUID
    Dim sSt As String                                       ' 吸引したステータス文字列
    
    On Error Resume Next
    
    ' 1. アクティブオブジェクトの生存確認。
    ' # 【判定】操作対象となるワークシートがメモリ上に存在するか。
    If ActiveSheet Is Nothing Then
        ' # 【目的】無効なオブジェクト参照による実行時エラーを物理的に回避するため。
        Exit Sub
    End If
    
    ' 2. 不変識別子の特定。
    ' # 【目的】CustomProperties に刻印された Base64 GUID をキーとして取得するため。
    sId = ExcelUtil.GetSheetIdSafe(ActiveSheet)
    
    ' # 【判定】シート識別子（GUID）が未設定、または取得に失敗したか。
    If sId = "" Then
        ' # 【目的】ステータス更新対象外のシートである事実を解析ログへ記録するため。
        Call HC_Log.Error("HC_Bridge", "RestoreStatBar: GUID not found for [" & ActiveSheet.Name & "]")
        ' 命令分離。
        Exit Sub
    End If
    
    ' 3. ステータス情報の物理吸引。
    ' # 【重要】通知用プロパティとは別に管理されている、ステータスバー表示専用の正本情報を取得。
    ' # 【動作補足】ExcelUtil.GetSheetInfo 内部で定数 HC_STATUS_INFO が参照される。
    sSt = ExcelUtil.GetSheetInfo(ActiveSheet)
    
    ' 4. UI（ステータスバー）への物理反映。
    ' # 【判定】シート固有の有効な履歴テキストが吸引できたか。
    If Len(sSt) > 0 Then
        ' # 【目的】シート切り替え時に、当該シートでの直近の処理結果をユーザーへ即座に再提示するため。
        Application.StatusBar = sSt
    Else
        ' # 【目的】未処理のシートにおいて、システムの待機状態を明示するため。
        Application.StatusBar = "CSV Tool Ready"
    End If
    
    ' 5. 解析証跡の物理記録。
    ' # 【目的】UI 同期処理が正常に完遂された事実と、対象 ID を保守ログへ残すため。
    Call HC_Log.Diag("HC_Bridge", "RestoreStatBar: UI synced for ID [" & sId & "]")
    
    On Error GoTo 0
End Sub

' ---------------------------------------------------------------------------------------------------------------------
' プロシージャ名: ClearStatBar
' 作成日: 2026-01-30
' 改版番号および履歴:
'   1.2.1 (2026-02-02) 開発規定に基づくヘッダ強化および意図コメント追加。
' プロシージャの動作概要: ステータスバーの制御権を解除し、Excel 標準の表示状態（Ready 等）へ物理復旧させる。
' 引数: なし
' 戻り値: なし
' 呼出し例: Call HC_Bridge.ClearStatBar()
' ヘルパープロシージャの親子関係:
'   (親) Main.TerminateProcess, AppEventClass.App_WorkbookBeforeClose
'   (子) HC_Log.Info
' 注意事項: 他のアドインとステータスバーを共有している場合は注意が必要。
' ---------------------------------------------------------------------------------------------------------------------
Public Sub ClearStatBar()
    ' 1. 表示制御の物理解放。
    ' # 【目的】アドインによるステータスバーの占有を解除し、Excel 本来のメッセージ表示機能に戻すため。
    Application.StatusBar = False
    
    ' 2. ログ記録。
    ' # 【目的】ステータスバーの所有権を破棄した事実を証跡として残すため。
    Call HC_Log.Info("HC_Bridge", "ClearStatBar: Status bar ownership returned to Excel.")
End Sub
