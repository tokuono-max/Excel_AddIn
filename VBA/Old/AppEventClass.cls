VERSION 1.0 CLASS
BEGIN
  MultiUse = -1  'True
END
Attribute VB_Name = "AppEventClass"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = False
Option Explicit

' ---------------------------------------------------------------------------------------------------------------------
' モジュール名: AppEventClass (クラスモジュール)
' 作成日: 2026-01-28
' 更新日: 2026-01-31
' 改版番号および履歴:
'   1.9.1 (2026-01-31) [最終仕様確定] VBA開発規定（非省略、1行1命令、ヘッダ強化、Comm禁止）を完全適用。
'                          Log を HC_Log へ一本化。
'   1.9.0 (2026-01-31) [最適化] 起動時の大量 GUID 生成を防止。全シート走査ロジックを廃止。
'                          GUID はシートがアクティブになった際、または機能実行時にのみ生成する。
'   1.8.0 (2026-01-31) CodeName 依存ロジックを完全排除。
' プロシージャの動作概要: Excel アプリケーション全体のイベントを物理捕捉し、不変識別子（GUID）の確定タイミングを制御する。
'                          リソース節約のため、シートがアクティブになった瞬間にのみ ID 確定プロセスを起動する。
' 注意事項: 本クラスは ThisWorkbook でインスタンス化され、メモリ上に常駐する。
'           1行1命令（マルチステートメント禁止）を死守すること。
' ---------------------------------------------------------------------------------------------------------------------

' --- 外部イベント接続定義 ---
' 【目的】WithEvents キーワードにより、Excel アプリケーション全体の挙動を物理捕捉するため。
Public WithEvents App As Application
Attribute App.VB_VarHelpID = -1


' ==============================================================================
' 標準イベントハンドラ・セクション
' ==============================================================================

' ---------------------------------------------------------------------------------------------------------------------
' コールバック名: App_NewWorkbook
' 作成日: 2026-01-28
' 改版番号および履歴: 1.3.0 (2026-01-31) 起動時負荷軽減のため GUID 生成を遅延化。
' プロシージャ? 動作概要: 新規ブック作成イベントを捕捉する。
' 引数: Wb (Workbook) - 新しく作成されたワークブック
' 戻り値: なし
' 呼出し例: システムより自動実行。
' ヘルパープロシージャの親子関係: (子) HC_Log.Info
' 注意事項: 起動時の GUID 大量生成を防止するため、ここでは ID 発行を執行しない。
' ---------------------------------------------------------------------------------------------------------------------
Private Sub App_NewWorkbook(ByVal Wb As Workbook)
    On Error Resume Next
    
    ' 1. 新規ブック検知のログ記録。
    ' 【目的】全シート走査を廃止し、オンデマンド生成（Deferred ID generation）へ移行した事実を記録するため。
    Call HC_Log.Diag("AppEventClass", "New workbook detected: " & Wb.Name & " (Deferred ID generation)")
    
    On Error GoTo 0
End Sub

' ---------------------------------------------------------------------------------------------------------------------
' コールバック名: App_WorkbookOpen
' 作成日: 2026-01-28
' 改版番号および履歴: 1.3.0 (2026-01-31) 起動時負荷軽減のため GUID 生成を遅延化。
' プロシージャの動作概要: 既存ブック開封イベントを捕捉する。
' 引数: Wb (Workbook) - 開かれたワークブック
' 戻り値: なし
' ---------------------------------------------------------------------------------------------------------------------
Private Sub App_WorkbookOpen(ByVal Wb As Workbook)
    On Error Resume Next
    
    ' 1. ブック開封検知のログ記録。
    ' 【目的】バックグラウンドでの ID 一括生成を防止し、Excel の起動速度を物理的に優先するため。
    Call HC_Log.Diag("AppEventClass", "Workbook open detected: " & Wb.Name & " (Deferred ID generation)")
    
    On Error GoTo 0
End Sub

' ---------------------------------------------------------------------------------------------------------------------
' コールバック名: App_SheetActivate
' 作成日: 2026-01-28
' 改版番号および履歴: 1.4.0 (2026-01-31) オンデマンド方式への完全移行と UI 同期。
' プロシージャの動作概要: シート切り替えイベントを捕捉する。
'                          このタイミングで活性化されたシート「のみ」に対して ID の確定と UI 復旧を執行する。
' 引数: Sh (Object) - 活性化されたシート
' 戻り値: なし
' ヘルパープロシージャの親子関係: (子) HC_Bridge.RestoreStatBar, HC_Log.Info
' ---------------------------------------------------------------------------------------------------------------------
Private Sub App_SheetActivate(ByVal Sh As Object)
    On Error Resume Next
    
    ' 1. シート活性化のログ記録。
    ' 【目的】ユーザーの操作コンテキストが切り替わったことを物理ログへ記録するため。
    Call HC_Log.Diag("AppEventClass", "Sheet activated: " & Sh.Name)
    
    ' 2. UI ブリッジを介した物理復元プロセスの執行。
    ' 【重要：オンデマンド確定】
    ' 【目的】ユーザーが実際に目にするシートに対してのみ ID を発行し、リソース消費を最小限にするため。
    ' 動作補足: RestoreStatBar 内部で ExcelUtil.GetSheetIdSafe が呼ばれ、ID が確定される。
    Call HC_Bridge.RestoreStatBar
    
    On Error GoTo 0
End Sub

' ==============================================================================
' 内部補助プロセッサ (廃止・互換性維持セクション)
' ==============================================================================

' ---------------------------------------------------------------------------------------------------------------------
' プロシージャ名: ProcessAllSheetsInWorkbook
' 作成日: 2026-01-28
' 改版番号および履歴: 3.0.0 (2026-01-31) 本機能の使用を停止（ブランク化）。
' プロシージャの動作概要: ブック内全シートへの ID 一括付与。
' 引数: targetWb (Workbook) - 対象ブック
' 戻り値: なし
' 注意事項: 本メソッドによる一括生成は「非常に多く作られる」原因となるため、的に処理を停止。
' ---------------------------------------------------------------------------------------------------------------------
Private Sub ProcessAllSheetsInWorkbook(ByVal targetWb As Workbook)
    ' 【目的】一括生成によるパフォーマンス低下を防止するため、処理をブランク化。
End Sub
